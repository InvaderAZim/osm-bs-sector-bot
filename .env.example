TELEGRAM_BOT_TOKEN=PASTE_NEW_BOTFATHER_TOKEN_HERE
PUBLIC_BASE_URL=https://your-public-domain.example
MAP_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DEFAULT_RADIUS_KM=15

# ID адміністратора або кілька ID через кому.
ADMIN_TELEGRAM_USER_IDS=123456789

# Необов'язковий статичний список користувачів із постійним доступом.
ALLOWED_TELEGRAM_USER_IDS=

# SQLite використовується лише як локальний fallback, якщо DATABASE_URL відсутній.
USER_DB_PATH=/tmp/dugazhtbot-users.db

# Для always-on production має бути false. Увімкніть лише на sleeping free-tier hosting.
DUGA_COLD_START_NOTICE=false

LOG_LEVEL=INFO
NOMINATIM_USER_AGENT=DUGA/3.0 (contact: your-email@example.com)
