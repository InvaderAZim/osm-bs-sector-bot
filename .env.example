TELEGRAM_BOT_TOKEN=1234567890:PASTE_BOTFATHER_TOKEN
PUBLIC_BASE_URL=https://your-public-domain.example
MAP_SECRET=replace-with-a-long-random-secret
DEFAULT_RADIUS_KM=15

# ID адміністратора або кілька ID через кому. Після заповнення нові користувачі
# отримуватимуть статус pending і вимагатимуть схвалення.
ADMIN_TELEGRAM_USER_IDS=123456789

# Необов'язковий статичний список користувачів із постійним доступом.
ALLOWED_TELEGRAM_USER_IDS=

# На Render Free локальна база може очищатися після перезапуску контейнера.
# Для постійного зберігання підключіть persistent disk або зовнішню БД.
USER_DB_PATH=/tmp/dugazhtbot-users.db

LOG_LEVEL=INFO
NOMINATIM_USER_AGENT=OSM-BS-Sector-Telegram-Bot/1.0 (contact: your-email@example.com)
