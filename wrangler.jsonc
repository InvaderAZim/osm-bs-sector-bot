{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "osm-bs-sector-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "DATABASE_URL",
      "ADMIN_TELEGRAM_USER_IDS",
      "TELEGRAM_WEBHOOK_SECRET",
      "SETUP_KEY"
    ]
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
