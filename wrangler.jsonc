{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "osm-bs-sector-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
